# Build output stays ignored - the working copy in dist/ is rebuilt on every
# change and is not what gets tracked.
dist/
build/
*.spec

# The installer .exe is a ~15 MB binary rebuilt on every change. It briefly
# lived tracked in this repo too (2026-09-21) and was moved back to
# Releases-only on 2026-09-22 - every commit while it was tracked added
# another full copy to git history with no way to remove it later short of
# rewriting history, for no benefit the Releases page did not already give.
*.exe

# Release bundles - assembled from the repo, not tracked in it.
*.zip

__pycache__/
*.pyc

# Measurement output, if a copy is ever pulled off the printer to look at.
qidi_pa/
*.json
!thr_dict_*.json

# INTERNAL NOTES - not for publication.
# Working records, design memos and machine-specific detail (SSH paths, this
# printer's address). The published source deliberately refers to none of these,
# so nothing in the repo dangles when they are absent.
CLAUDE.md
NEXT_SESSION.md
PLAN.md
FINDINGS.md
HARDWARE_MAP.md
STAGE1_DESIGN.md
STAGE1_SEARCH_DESIGN.md
STAGE2_DESIGN.md
STAGE3_DESIGN.md

# Firmware reverse-engineering tooling - not needed to calibrate.
qidi_fw_dict.py
thr_dict_*.json

# Superseded, never installed.
qidi_pa_discover.py
