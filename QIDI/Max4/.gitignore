# Build output stays ignored - the working copy in dist/ is rebuilt on every
# change and is not what gets tracked.
dist/
build/
*.spec

# The installer itself: ignored by extension, then the one shipped copy is
# named back in below. It is ALSO attached to each GitHub Release as a
# download asset - so it exists in two places on purpose, at Budd's request:
# every push after this one adds another full ~15 MB copy to git history,
# with no way to remove it later short of rewriting history, and the Release
# asset already covers the same download without that cost. Kept anyway
# because it means the exe is visible directly in the repo's file list, not
# only on the Releases page.
*.exe
!QIDI-Max4-Calibration-Installer.exe

# Release bundles - assembled from the repo, not tracked in it.
*.zip

__pycache__/
*.pyc

# Measurement output, if a copy is ever pulled off the printer to look at.
qidi_pa/
*.json
!thr_dict_*.json

# INTERNAL NOTES - not for publication.
# Working records, design memos and machine-specific detail (SSH paths, this
# printer's address). The published source deliberately refers to none of these,
# so nothing in the repo dangles when they are absent.
CLAUDE.md
NEXT_SESSION.md
PLAN.md
FINDINGS.md
HARDWARE_MAP.md
STAGE1_DESIGN.md
STAGE1_SEARCH_DESIGN.md
STAGE2_DESIGN.md
STAGE3_DESIGN.md

# Firmware reverse-engineering tooling - not needed to calibrate.
qidi_fw_dict.py
thr_dict_*.json

# Superseded, never installed.
qidi_pa_discover.py
